# Rename to secrets.toml for local use, or paste these into
# Streamlit Cloud → App → Settings → Secrets.
# NEVER commit a real secrets.toml to git.

OPENROUTER_API_KEY = "sk-or-v1-your-key-here"
OPENROUTER_MODEL = "openai/gpt-4o-mini"

# REQUIRED on Streamlit Cloud so accounts survive redeploys — see the
# "Persistence" section of README.md. Without these, every signed-up
# account is wiped the next time the app redeploys or reboots.
TURSO_DATABASE_URL = "libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN = "your-turso-auth-token"
