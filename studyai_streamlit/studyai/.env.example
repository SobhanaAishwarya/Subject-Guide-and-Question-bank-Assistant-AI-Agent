# ============================================================
# StudyAI — environment variables
# Copy this file to .env and fill in your key.
# ============================================================

# REQUIRED — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OPTIONAL — default model used for every generation
OPENROUTER_MODEL=openai/gpt-4o-mini

# OPTIONAL — attribution headers shown on your OpenRouter dashboard
OPENROUTER_SITE_URL=https://your-app.streamlit.app

# REQUIRED for Streamlit Cloud (optional for local dev) — a free Turso
# database (https://turso.tech) so accounts and study data survive
# redeploys. Without these, the app falls back to a local SQLite file that
# Streamlit Cloud wipes on every deploy/reboot, and every account you sign
# up disappears. Get these from `turso db show <db-name>` and
# `turso db tokens create <db-name>` after `turso db create studyai`.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
